# PlayMatch Mobile Environment Variables
# For Android Emulator use: http://10.0.2.2:5000/api/v1
# For Physical Device (Expo Go) use: http://<YOUR_LOCAL_LAN_IP>:5000/api/v1
# For iOS Simulator use: http://localhost:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/v1
EXPO_PUBLIC_QUERY_POLLING_INTERVAL_MS=10000
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Feature Modes (mock | live)
EXPO_PUBLIC_FEATURE_RECOMMENDATIONS_MODE=mock
EXPO_PUBLIC_FEATURE_TEAMS_MODE=mock
EXPO_PUBLIC_FEATURE_RESULTS_MODE=mock
EXPO_PUBLIC_FEATURE_NOTIFICATIONS_MODE=mock
EXPO_PUBLIC_FEATURE_RELIABILITY_MODE=mock

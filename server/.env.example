# ==============================================================================
# PlayMatch Environment Configuration (.env.example)
# Module 1: Authentication & Identity
# Module 2: Player Profile & Onboarding
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port (1-65535)
PORT=5000

# Logging Verbosity Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# MongoDB Connection String URI (Single-node replica set required for transactions)
# For local Docker replica set: mongodb://localhost:27017/playmatch?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://localhost:27017/playmatch?replicaSet=rs0&directConnection=true

# Base Path Prefix for all API endpoints
API_BASE_PATH=/api/v1

# Frontend Web Application URL (used for links in emails e.g. verify email, reset password)
CLIENT_WEB_URL=http://localhost:3000

# JWT Access Token Secret (minimum 32 characters required)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long

# JWT Refresh Token Secret (minimum 32 characters required)
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# JWT Access Token Time-To-Live (e.g. 15m, 1h, 900s)
ACCESS_TOKEN_TTL=15m

# Refresh Token Time-To-Live (e.g. 7d, 30d)
REFRESH_TOKEN_TTL=7d

# Password Hashing Cost / Salt Rounds (positive integer, recommended: 12)
PASSWORD_HASH_COST=12

# Minimum Password Length (integer >= 8)
PASSWORD_MIN_LENGTH=8

# Require Password Complexity (true = requires uppercase, lowercase, number, special char)
PASSWORD_REQUIRE_COMPLEXITY=true

# Maximum Allowed Consecutive Failed Logins Before Account Lockout
MAX_FAILED_LOGINS=5

# Duration of Account Lockout in Minutes
LOCKOUT_MINUTES=15

# Whether Email Verification is Mandatory to Access Protected Resources (true | false)
EMAIL_VERIFICATION_REQUIRED=true

# Email Verification Token Time-To-Live (e.g. 24h, 86400s)
EMAIL_TOKEN_TTL=24h

# Password Reset Token Time-To-Live (e.g. 1h, 3600s)
PASSWORD_RESET_TOKEN_TTL=1h

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Refresh Cookie Domain (leave empty for current domain in dev, or set to .example.com)
COOKIE_DOMAIN=localhost

# Refresh Cookie Secure Flag (true = HTTPS only; false in local HTTP dev)
COOKIE_SECURE=false

# Refresh Cookie SameSite Policy (lax | strict | none)
COOKIE_SAMESITE=lax

# Refresh Cookie Name
REFRESH_COOKIE_NAME=playmatch_refresh

# Rate Limiter Window in Milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum Requests Per IP within the Window (General routes)
RATE_LIMIT_MAX=100

# Maximum Requests Per IP within the Window (Sensitive Auth routes)
AUTH_RATE_LIMIT_MAX=10

# Email Delivery Transport (smtp | console)
# Set to 'console' for local dev: prints generated emails to application logger
EMAIL_TRANSPORT=console

# SMTP Host (required if EMAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.mailtrap.io

# SMTP Port (required if EMAIL_TRANSPORT=smtp, e.g. 25, 465, 587, 2525)
SMTP_PORT=587

# SMTP Username (required if EMAIL_TRANSPORT=smtp)
SMTP_USER=smtp_username_placeholder

# SMTP Password (required if EMAIL_TRANSPORT=smtp)
SMTP_PASS=smtp_password_placeholder

# Default From Address for Outgoing Emails
EMAIL_FROM="PlayMatch Team" <noreply@playmatch.app>

# HTTP Header Name for Client Type (web | mobile)
CLIENT_HEADER_NAME=x-client-type

# ------------------------------------------------------------------------------
# Module 2: Player Profile & Onboarding Settings
# ------------------------------------------------------------------------------

# Default Seed Rating (fallback if a skill band has no rating defined)
DEFAULT_SEED_RATING=1200

# Games Played Threshold before a Player's Rating is no longer provisional
PROVISIONAL_GAMES_THRESHOLD=10

# Maximum number of sports a player can simultaneously configure
MAX_SPORTS_PER_PLAYER=5

# Minimum and Maximum allowable travel search radius in kilometers
MIN_TRAVEL_RADIUS_KM=1
MAX_TRAVEL_RADIUS_KM=100

# Default initial travel search radius in kilometers
DEFAULT_TRAVEL_RADIUS_KM=15

# Maximum availability time slots a player can configure per day of week
MAX_AVAILABILITY_SLOTS_PER_DAY=6

# Minimum duration for an individual availability slot in minutes
MIN_SLOT_DURATION_MINUTES=30

# Decimal precision to round public coordinates to (e.g. 2 decimals ~ 1.1km area)
LOCATION_PUBLIC_PRECISION_DECIMALS=2

# Maximum character length for user bio
BIO_MAX_LENGTH=500

# Display Name character length constraints
NAME_MIN_LENGTH=2
NAME_MAX_LENGTH=50

# Player Age constraints (evaluated against dateOfBirth)
MIN_AGE=13
MAX_AGE=100

# File path to the canonical Sports Catalog JSON seed file
SPORTS_SEED_FILE=./src/data/sports-seed.json

# Default fallback timezone suggestion
DEFAULT_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Module 3: Rating Engine Settings
# ------------------------------------------------------------------------------

# Scale divisor D in Elo expected score formula E = 1 / (1 + 10^((R_opp - R_self) / D))
RATING_SCALE_DIVISOR=400

# K-Factor Tiers JSON array (sorted by upToGames, positive k, last tier open-ended with null)
RATING_K_TIERS=[{"upToGames":10,"k":40},{"upToGames":30,"k":32},{"upToGames":null,"k":24}]

# Margin of Victory (MOV) settings
MOV_ENABLED=true
MOV_WEIGHT=0.5

# Rating range bounds and storage precision
RATING_MIN=100
RATING_MAX=3000
RATING_DECIMALS=1

# Team rating aggregation strategy (mean)
TEAM_RATING_AGGREGATION=mean

# Inactivity boost parameters
INACTIVITY_DAYS=30
INACTIVITY_K_MULTIPLIER=1.5

# Confidence metric parameters (0 to 1 scale)
CONFIDENCE_GAMES_THRESHOLD=30
CONFIDENCE_RECENCY_HALF_LIFE_DAYS=60

# Leaderboard settings
LEADERBOARD_PAGE_SIZE_DEFAULT=20
LEADERBOARD_PAGE_SIZE_MAX=100
LEADERBOARD_EXCLUDE_PROVISIONAL=true

# History pagination settings
HISTORY_PAGE_SIZE_DEFAULT=20
HISTORY_PAGE_SIZE_MAX=100

# Fallback team size if sport has no maxPlayers defined
MAX_PLAYERS_PER_SIDE_FALLBACK=11

# ------------------------------------------------------------------------------
# Module 4: Games & Scheduling Settings
# ------------------------------------------------------------------------------

# Minimum minutes into the future a game must be scheduled
GAME_CREATION_LEAD_TIME_MINUTES=30

# Maximum days into the future a game can be scheduled
GAME_MAX_ADVANCE_DAYS=14

# Minimum and Maximum allowable game duration in minutes
GAME_MIN_DURATION_MINUTES=30
GAME_MAX_DURATION_MINUTES=240

# Join cutoff minutes before game start time
JOIN_CUTOFF_MINUTES_BEFORE_START=15

# Leave cutoff minutes before game start time (leaves after this are marked late)
LEAVE_CUTOFF_MINUTES_BEFORE_START=60

# Waitlist expiration minutes before start time
WAITLIST_AUTO_EXPIRE_MINUTES_BEFORE_START=15

# Hours before unapproved join requests expire
JOIN_REQUEST_AUTO_EXPIRE_HOURS=24

# Whether to auto-confirm eligible games at join cutoff
AUTO_CONFIRM_AT_CUTOFF=true

# Grace minutes after startsAt before transitioning confirmed game to in_progress
AUTO_IN_PROGRESS_GRACE_MINUTES=5

# Delay minutes after endsAt before transitioning in_progress game to completed
AUTO_COMPLETE_DELAY_MINUTES=30

# Lifecycle background sweep interval in milliseconds
LIFECYCLE_SWEEP_INTERVAL_MS=60000

# Maximum capacity of the waitlist per game
WAITLIST_MAX_SIZE=10

# Default setting whether unrated players are allowed in rating-restricted games
RATING_ALLOW_UNRATED_DEFAULT=true

# Default rating window width for restricted games
DEFAULT_RATING_WINDOW=200

# Maximum allowed rating window width for restricted games
MAX_RATING_WINDOW=1000

# Maximum length for game cancellation reason
CANCEL_REASON_MAX_LENGTH=500

# Pagination settings for /games lists
GAMES_LIST_PAGE_SIZE_DEFAULT=20
GAMES_LIST_PAGE_SIZE_MAX=100

# Length of random invite code generated for private games
INVITE_CODE_LENGTH=8

# ------------------------------------------------------------------------------
# Module 5: Geo Discovery & Venues Settings
# ------------------------------------------------------------------------------

# Discovery search radius bounds (in kilometers)
DISCOVERY_DEFAULT_RADIUS_KM=15
DISCOVERY_MIN_RADIUS_KM=1
DISCOVERY_MAX_RADIUS_KM=50

# Pagination settings for geo discovery
DISCOVERY_PAGE_SIZE_DEFAULT=20
DISCOVERY_PAGE_SIZE_MAX=50

# Maximum game eligibility explanations computed per page
DISCOVERY_MAX_ELIGIBILITY_EXPLAIN_PER_PAGE=10

# Rounding step for distance of free-form games to prevent triangulation (in km)
DISTANCE_PRIVACY_ROUNDING_KM=0.5

# Venue string length limits
VENUE_NAME_MAX_LENGTH=100
VENUE_DESCRIPTION_MAX_LENGTH=1000

# Capacity limits per owner and venue
MAX_VENUES_PER_OWNER=10
MAX_COURTS_PER_VENUE=20
VENUE_PHOTOS_MAX=10
VENUE_AMENITIES_MAX=20

# Require admin approval before newly created venue becomes active
VENUE_REQUIRE_ADMIN_APPROVAL=true

# Buffer minutes required between consecutive games on the same court
COURT_BUFFER_MINUTES=15

# Venue suggestion query settings for game rosters
VENUE_SUGGESTION_MAX_RESULTS=5
VENUE_SUGGESTION_RADIUS_KM=30
MIN_PARTICIPANTS_FOR_VENUE_SUGGESTION=4

# Whether games can be created with free-form locations without a venue
FREEFORM_LOCATION_ALLOWED=true

